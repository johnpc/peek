<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <!-- Screen Sharing / VNC servers advertise themselves over Bonjour as
         _rfb._tcp. iOS requires both a usage string and the exact service
         types the app browses before it will show the local-network prompt. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>peek uses the local network to find Macs with Screen Sharing turned on and to connect to them.</string>
    <!-- peek://connect?host=<saved name or address> opens straight into a computer
         (Shortcuts, the Action Button, Siri "Open URL"). -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.johncorser.peek</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>peek</string>
            </array>
        </dict>
    </array>
    <key>NSBonjourServices</key>
    <array>
        <string>_rfb._tcp</string>
    </array>
</dict>
</plist>
